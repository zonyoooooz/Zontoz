local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Window = Fluent:CreateWindow({
    Title = "ZERO | TPS ULTIMATE",
    SubTitle = "By zon",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Acrylic = false,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl
})

local Tabs = {
    Main = Window:AddTab({ Title = "Reach", Icon = "zap" }),
    Abilities = Window:AddTab({ Title = "Abilities", Icon = "star" })
}

getgenv().ZonConfig = {
    Enabled = false,
    Size = 10,
    FastCooldown = false,
    MoreCurve = false
}

local oldIndex
oldIndex = hookmetamethod(game, "__index", function(self, key)
    if not checkcaller() then
        local name = self.Name
        if getgenv().ZonConfig.FastCooldown and (name == "FasterCooldown" or name == "FastCooldown") and key == "Value" then
            return true
        end
        if getgenv().ZonConfig.MoreCurve and (name == "MoreCurve" or name == "DoubleCurve") and key == "Value" then
            return true
        end
    end
    return oldIndex(self, key)
end)

local ReachSection = Tabs.Main:AddSection("Reach Configuration")

Tabs.Main:AddToggle("ReachToggle", { 
    Title = "Enable Reach", 
    Default = false, 
    Callback = function(v) getgenv().ZonConfig.Enabled = v end 
})

Tabs.Main:AddInput("ReachInput", {
    Title = "Reach Size (Type Number)",
    Default = "10",
    Numeric = true,
    Finished = true,
    Callback = function(Value)
        local num = tonumber(Value)
        if num then
            if num > 19 then num = 19 end
            getgenv().ZonConfig.Size = num
        end
    end
})

Tabs.Main:AddSlider("ReachSlider", { 
    Title = "Reach Slider", 
    Min = 1, Max = 19, Default = 10, 
    Rounding = 1, 
    Callback = function(v) getgenv().ZonConfig.Size = v end 
})

local AbilitySection = Tabs.Abilities:AddSection("Gamepass Emulation")

Tabs.Abilities:AddToggle("CooldownToggle", { 
    Title = "Faster Cooldown (Inject)", 
    Default = false, 
    Callback = function(v) getgenv().ZonConfig.FastCooldown = v end 
})

Tabs.Abilities:AddToggle("CurveToggle", { 
    Title = "Maximum Curve (Inject)", 
    Default = false, 
    Callback = function(v) getgenv().ZonConfig.MoreCurve = v end 
})

local lastPulse = 0
game:GetService("RunService").Heartbeat:Connect(function()
    pcall(function()
        local lp = game.Players.LocalPlayer
        local char = lp.Character
        
        if getgenv().ZonConfig.Enabled and char then
            local ball = workspace.TPSSystem.TPS
            local root = char:FindFirstChild("HumanoidRootPart")
            if root and ball then
                local dist = (root.Position - ball.Position).Magnitude
                if dist <= getgenv().ZonConfig.Size then
                    local now = tick()
                    if now - lastPulse >= 0.05 then
                        firetouchinterest(root, ball, 0)
                        firetouchinterest(root, ball, 1)
                        lastPulse = now
                    end
                end
            end
        end

        if char then
            local values = char:FindFirstChild("Values")
            if values then
                if getgenv().ZonConfig.FastCooldown then
                    local cd = values:FindFirstChild("Cooldown")
                    if cd then cd.Value = 0 end
                end
                if getgenv().ZonConfig.MoreCurve then
                    local curve = values:FindFirstChild("CanCurve")
                    if curve then curve.Value = true end
                end
            end
        end
    end)
end)

Window:SelectTab(1)
