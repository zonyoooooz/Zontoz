local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Window = Fluent:CreateWindow({
    Title = "ZERO | TPS ULTIMATE",
    SubTitle = "By zon",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Acrylic = false,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl
})

local Tabs = {
    Main = Window:AddTab({ Title = "Reach", Icon = "zap" }),
    Exploits = Window:AddTab({ Title = "Exploits", Icon = "ghost" })
}

getgenv().ZonConfig = {
    Enabled = false,
    Size = 10,
    AntiGK = false
}

local ReachSection = Tabs.Main:AddSection("Reach Configuration")

Tabs.Main:AddToggle("ReachToggle", { 
    Title = "Enable Reach", 
    Default = false, 
    Callback = function(v) getgenv().ZonConfig.Enabled = v end 
})

Tabs.Main:AddInput("ReachInput", {
    Title = "Reach Size (Type Number)",
    Default = "10",
    Numeric = true,
    Finished = true,
    Callback = function(Value)
        local num = tonumber(Value)
        if num then
            if num > 19 then num = 19 end
            getgenv().ZonConfig.Size = num
        end
    end
})

Tabs.Main:AddSlider("ReachSlider", { 
    Title = "Reach Slider", 
    Min = 1, Max = 19, Default = 10, 
    Rounding = 1, 
    Callback = function(v) getgenv().ZonConfig.Size = v end 
})

local ExploitSection = Tabs.Exploits:AddSection("Keeper Bypass")

Tabs.Exploits:AddToggle("AntiGKToggle", { 
    Title = "Anti-GK (Ghost Shot)", 
    Default = false, 
    Callback = function(v) getgenv().ZonConfig.AntiGK = v end 
})

local lastPulse = 0
game:GetService("RunService").Heartbeat:Connect(function()
    pcall(function()
        local lp = game.Players.LocalPlayer
        local char = lp.Character
        local ball = workspace.TPSSystem.TPS
        
        if getgenv().ZonConfig.Enabled and char and ball then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                local dist = (root.Position - ball.Position).Magnitude
                if dist <= getgenv().ZonConfig.Size then
                    local now = tick()
                    if now - lastPulse >= 0.05 then
                        firetouchinterest(root, ball, 0)
                        firetouchinterest(root, ball, 1)
                        lastPulse = now
                    end
                end
            end
        end

        if getgenv().ZonConfig.AntiGK and ball then
            for _, player in pairs(game.Players:GetPlayers()) do
                if player ~= lp and player.Team ~= lp.Team then
                    local targetChar = player.Character
                    if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
                        local dist = (ball.Position - targetChar.HumanoidRootPart.Position).Magnitude
                        if dist < 8 then
                            ball.Velocity = ball.Velocity + (ball.Velocity.Unit * 15)
                        end
                    end
                end
            end
        end
    end)
end)

Window:SelectTab(1)
