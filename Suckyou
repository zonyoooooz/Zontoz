local Window = Fluent:CreateWindow({
    Title = "TPS: Street Soccer 🏆",
    SubTitle = "By zon",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Acrylic = false,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl
})

local Tabs = {
    Reach = Window:AddTab({ Title = "Reach", Icon = "mouse-pointer" }),
    FlagFunc = Window:AddTab({ Title = "Flag Func", Icon = "code" })
}

local ReachConfig = { Enabled = false, Size = 4 }

Tabs.Reach:AddToggle("ReachToggle", {
    Title = "Enable Reach",
    Default = false,
    Callback = function(Value) ReachConfig.Enabled = Value end
})

Tabs.Reach:AddSlider("ReachSlider", {
    Title = "Reach Size",
    Min = 1, Max = 50, Default = 4,
    Rounding = 1,
    Callback = function(Value) ReachConfig.Size = Value end
})

local FlagData = { Delay = "4" }

Tabs.FlagFunc:AddInput("TargetDelay", {
    Title = "TargetTimeDelay",
    Default = "4",
    Callback = function(Value) FlagData.Delay = Value end
})

Tabs.FlagFunc:AddButton({
    Title = "Apply & Lock",
    Callback = function()
        pcall(function()
            settings().Network.IncomingReplicationLag = tonumber(FlagData.Delay) / 1000
            Fluent:Notify({Title = "System", Content = "Applied", Duration = 2})
        end)
    end
})

game:GetService("RunService").Heartbeat:Connect(function()
    if ReachConfig.Enabled then
        pcall(function()
            local ball = workspace.TPSSystem.TPS
            local root = game.Players.LocalPlayer.Character.HumanoidRootPart
            if (root.Position - ball.Position).Magnitude <= (ReachConfig.Size * 1.5) then
                firetouchinterest(root, ball, 0)
                firetouchinterest(root, ball, 1)
            end
        end)
    end
end)

Window:SelectTab(1)
